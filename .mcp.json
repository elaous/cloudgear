{
  "mcpServers": {
    "awslabs.lambda-tool-mcp-server": {
      "command": "uvx",
      "args": ["awslabs.lambda-tool-mcp-server@2.1.1"],
      "env": {
        "AWS_REGION": "${AWS_REGION:-${AWS_DEFAULT_REGION:-us-east-1}}",
        "FUNCTION_TAG_KEY": "cloudgear:managed-by",
        "FUNCTION_TAG_VALUE": "cloudgear"
      }
    }
  }
}
