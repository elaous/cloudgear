{
  "name": "cloudgear",
  "version": "0.1.0",
  "private": true,
  "description": "Write your HTTP API in TypeScript and cloudgear plans the cloud infrastructure from it, reviewable before you apply.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elaous/cloudgear.git"
  },
  "bugs": {
    "url": "https://github.com/elaous/cloudgear/issues"
  },
  "type": "module",
  "module": "src/cli.ts",
  "scripts": {
    "link": "bun link cloudgear && for p in ./packages/*; do cd $p; bun link; cd -; done",
    "generate": "bun src/cli.ts generate",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "bun test"
  },
  "devDependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@biomejs/biome": "^2.6.6",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.4",
    "@types/bun": "latest",
    "jose": "^6.2.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@aws-sdk/client-acm": "^3.700.0",
    "@aws-sdk/client-apigatewayv2": "^3.1156.0",
    "@aws-sdk/client-cloudfront": "^3.700.0",
    "@aws-sdk/client-eventbridge": "^3.1156.0",
    "@aws-sdk/client-iam": "^3.700.0",
    "@aws-sdk/client-lambda": "^3.700.0",
    "@aws-sdk/client-route-53": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.1162.0",
    "@aws-sdk/client-ssm": "^3.1162.0",
    "@cloudgear/blob": "workspace:*",
    "@cloudgear/cdn": "workspace:*",
    "@cloudgear/core": "workspace:*",
    "@cloudgear/debug": "workspace:*",
    "@cloudgear/dns": "workspace:*",
    "@cloudgear/events": "workspace:*",
    "@cloudgear/functions": "workspace:*",
    "@cloudgear/secrets": "workspace:*",
    "ts-morph": "^24.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "cloudgear": "src/cli.ts"
  }
}
