{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/node_modules", "!**/.cloudgear", "!tests/fixtures", "!bun.lock"]
  },
  "formatter": { "enabled": false },
  "assist": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "style": { "noNonNullAssertion": "off" },
      "suspicious": { "noExplicitAny": "off", "noTemplateCurlyInString": "off" },
      "complexity": { "noStaticOnlyClass": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["tests/**"],
      "linter": {
        "rules": {
          "suspicious": { "noAssignInExpressions": "off" },
          "complexity": { "noCommaOperator": "off" }
        }
      }
    },
    {
      "includes": ["examples/**"],
      "linter": { "rules": { "correctness": { "noUnusedVariables": "off" } } }
    }
  ]
}
